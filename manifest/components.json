{
  "profiles": {
    "minimal": {
      "description": "Bare essentials — build tools, git, Node and Claude Code.",
      "harnesses": [
        "claude-code"
      ],
      "components": [
        "base",
        "git",
        "node",
        "claude-code"
      ]
    },
    "developer": {
      "description": "Full multi-agent workstation. The default.",
      "harnesses": [
        "claude-code",
        "codex",
        "opencode"
      ],
      "components": [
        "base",
        "git",
        "cli-utils",
        "python",
        "ruff",
        "node",
        "rust",
        "ast-grep",
        "tree-sitter",
        "pyright",
        "docker",
        "github-cli",
        "claude-code",
        "codex",
        "codex-config",
        "opencode",
        "codegraph",
        "superpowers",
        "caveman",
        "grill-me",
        "claude-mem",
        "context7"
      ]
    },
    "django": {
      "description": "Developer profile plus a Python/Django service toolchain.",
      "harnesses": [
        "claude-code",
        "codex",
        "opencode"
      ],
      "components": [
        "base",
        "git",
        "cli-utils",
        "python",
        "ruff",
        "node",
        "rust",
        "ast-grep",
        "tree-sitter",
        "pyright",
        "docker",
        "github-cli",
        "django-toolchain",
        "claude-code",
        "codex",
        "codex-config",
        "opencode",
        "codegraph",
        "superpowers",
        "caveman",
        "grill-me",
        "claude-mem",
        "context7"
      ]
    },
    "gis": {
      "description": "Developer profile plus a geospatial stack (GDAL, PostGIS client, tiling).",
      "harnesses": [
        "claude-code",
        "codex",
        "opencode"
      ],
      "components": [
        "base",
        "git",
        "cli-utils",
        "python",
        "ruff",
        "node",
        "rust",
        "ast-grep",
        "tree-sitter",
        "pyright",
        "docker",
        "github-cli",
        "gis-toolchain",
        "claude-code",
        "codex",
        "codex-config",
        "opencode",
        "codegraph",
        "superpowers",
        "caveman",
        "grill-me",
        "claude-mem",
        "context7"
      ]
    },
    "full": {
      "description": "Everything, every harness. Slowest install.",
      "harnesses": [
        "claude-code",
        "codex",
        "opencode"
      ],
      "components": [
        "base",
        "git",
        "cli-utils",
        "python",
        "uv",
        "ruff",
        "node",
        "rust",
        "ast-grep",
        "tree-sitter",
        "pyright",
        "docker",
        "github-cli",
        "django-toolchain",
        "gis-toolchain",
        "claude-code",
        "codex",
        "codex-config",
        "opencode",
        "codegraph",
        "superpowers",
        "caveman",
        "grill-me",
        "claude-mem",
        "context7"
      ]
    }
  },
  "components": [
    {
      "id": "base",
      "type": "tool",
      "backend": "apt",
      "description": "Compilers, headers and the certificate/HTTP basics everything else needs.",
      "sudo": true,
      "tags": [
        "system",
        "core"
      ],
      "packages": [
        "build-essential",
        "cmake",
        "make",
        "gcc",
        "g++",
        "pkg-config",
        "software-properties-common",
        "ca-certificates",
        "curl",
        "wget",
        "jq",
        "zip",
        "unzip",
        "gnupg",
        "xz-utils",
        "file"
      ],
      "bin": "gcc",
      "verify": {
        "kind": "command",
        "cmd": "gcc --version",
        "match": "[0-9]+\\.[0-9]+"
      }
    },
    {
      "id": "git",
      "type": "tool",
      "backend": "apt",
      "description": "Distributed version control.",
      "sudo": true,
      "requires": [
        "base"
      ],
      "tags": [
        "system",
        "core"
      ],
      "packages": [
        "git",
        "git-lfs"
      ],
      "bin": "git",
      "verify": {
        "kind": "command",
        "cmd": "git --version",
        "match": "git version"
      }
    },
    {
      "id": "cli-utils",
      "type": "tool",
      "backend": "apt",
      "description": "Modern terminal toolkit — ripgrep, fd, bat, eza, fzf, zoxide, tmux.",
      "sudo": true,
      "requires": [
        "base"
      ],
      "tags": [
        "system",
        "cli"
      ],
      "packages": [
        "ripgrep",
        "fd-find",
        "bat",
        "eza",
        "fzf",
        "zoxide",
        "tree",
        "tmux",
        "htop",
        "ncdu"
      ],
      "bin": "rg",
      "verify": {
        "kind": "command",
        "cmd": "rg --version",
        "match": "ripgrep"
      }
    },
    {
      "id": "python",
      "type": "tool",
      "backend": "apt",
      "description": "Python 3 with venv and pipx (PEP 668 safe — never pip --user).",
      "sudo": true,
      "requires": [
        "base"
      ],
      "tags": [
        "lang",
        "python"
      ],
      "packages": [
        "python3",
        "python3-venv",
        "python3-pip",
        "pipx"
      ],
      "bin": "python3",
      "verify": {
        "kind": "command",
        "cmd": "python3 --version",
        "match": "Python 3"
      }
    },
    {
      "id": "uv",
      "type": "tool",
      "backend": "script",
      "description": "Fast Python package and tool manager. Installs to ~/.local/bin.",
      "requires": [
        "base",
        "python"
      ],
      "tags": [
        "lang",
        "python"
      ],
      "bin": "uv",
      "relogin": true,
      "script": {
        "url": "https://astral.sh/uv/install.sh",
        "update": "uv self update",
        "uninstall": "uv self uninstall"
      },
      "verify": {
        "kind": "command",
        "cmd": "uv --version",
        "match": "uv "
      }
    },
    {
      "id": "ruff",
      "type": "tool",
      "backend": "uv-tool",
      "description": "Python linter and formatter.",
      "requires": [
        "uv"
      ],
      "package": "ruff",
      "tags": [
        "lang",
        "python",
        "lint"
      ],
      "bin": "ruff",
      "verify": {
        "kind": "command",
        "cmd": "ruff --version",
        "match": "ruff "
      }
    },
    {
      "id": "fnm",
      "type": "tool",
      "backend": "script",
      "description": "Fast Node Manager. Keeps Node entirely in $HOME, so npm -g needs no sudo.",
      "requires": [
        "base"
      ],
      "tags": [
        "lang",
        "node"
      ],
      "bin": "fnm",
      "relogin": true,
      "script": {
        "url": "https://fnm.vercel.app/install",
        "args": "--skip-shell"
      },
      "verify": {
        "kind": "command",
        "cmd": "fnm --version",
        "match": "fnm "
      }
    },
    {
      "id": "node",
      "type": "tool",
      "backend": "none",
      "description": "Node.js LTS, installed through fnm into user space.",
      "requires": [
        "fnm"
      ],
      "tags": [
        "lang",
        "node"
      ],
      "bin": "node",
      "relogin": true,
      "verify": {
        "kind": "command",
        "cmd": "node --version",
        "match": "v[0-9]+"
      }
    },
    {
      "id": "rust",
      "type": "tool",
      "backend": "script",
      "description": "Rust toolchain via rustup (stable channel).",
      "requires": [
        "base"
      ],
      "tags": [
        "lang",
        "rust"
      ],
      "bin": "cargo",
      "relogin": true,
      "script": {
        "url": "https://sh.rustup.rs",
        "args": "-y --no-modify-path --profile minimal",
        "update": "rustup update stable",
        "uninstall": "rustup self uninstall -y"
      },
      "verify": {
        "kind": "command",
        "cmd": "cargo --version",
        "match": "cargo "
      }
    },
    {
      "id": "ast-grep",
      "type": "tool",
      "backend": "npm-global",
      "description": "Structural search and rewrite based on tree-sitter.",
      "requires": [
        "node"
      ],
      "package": "@ast-grep/cli",
      "tags": [
        "cli",
        "codemod"
      ],
      "bin": "ast-grep",
      "verify": {
        "kind": "command",
        "cmd": "ast-grep --version",
        "match": "ast-grep"
      }
    },
    {
      "id": "tree-sitter",
      "type": "tool",
      "backend": "npm-global",
      "description": "Tree-sitter CLI, for grammar work and parser debugging.",
      "requires": [
        "node"
      ],
      "package": "tree-sitter-cli",
      "tags": [
        "cli",
        "parsing"
      ],
      "bin": "tree-sitter",
      "verify": {
        "kind": "command",
        "cmd": "tree-sitter --version",
        "match": "tree-sitter"
      }
    },
    {
      "id": "pyright",
      "type": "tool",
      "backend": "npm-global",
      "description": "Static type checker for Python.",
      "requires": [
        "node"
      ],
      "package": "pyright",
      "tags": [
        "lang",
        "python",
        "lint"
      ],
      "bin": "pyright",
      "verify": {
        "kind": "command",
        "cmd": "pyright --version",
        "match": "pyright"
      }
    },
    {
      "id": "docker",
      "type": "tool",
      "backend": "apt-repo",
      "description": "Docker Engine and Compose from Docker's official apt repository.",
      "sudo": true,
      "relogin": true,
      "requires": [
        "base"
      ],
      "tags": [
        "system",
        "containers"
      ],
      "bin": "docker",
      "repo": {
        "id": "docker",
        "key_url": "https://download.docker.com/linux/ubuntu/gpg",
        "uri": "https://download.docker.com/linux/ubuntu",
        "suite": "${VERSION_CODENAME}",
        "components": "stable"
      },
      "packages": [
        "docker-ce",
        "docker-ce-cli",
        "containerd.io",
        "docker-buildx-plugin",
        "docker-compose-plugin"
      ],
      "verify": {
        "kind": "command",
        "cmd": "docker --version",
        "match": "Docker version"
      }
    },
    {
      "id": "github-cli",
      "type": "tool",
      "backend": "apt-repo",
      "description": "GitHub CLI (gh).",
      "sudo": true,
      "requires": [
        "base"
      ],
      "tags": [
        "system",
        "git"
      ],
      "bin": "gh",
      "repo": {
        "id": "github-cli",
        "key_url": "https://cli.github.com/packages/githubcli-archive-keyring.gpg",
        "uri": "https://cli.github.com/packages",
        "suite": "stable",
        "components": "main"
      },
      "packages": [
        "gh"
      ],
      "verify": {
        "kind": "command",
        "cmd": "gh --version",
        "match": "gh version"
      }
    },
    {
      "id": "claude-code",
      "type": "harness",
      "backend": "npm-global",
      "description": "Anthropic's Claude Code agent.",
      "requires": [
        "node"
      ],
      "package": "@anthropic-ai/claude-code",
      "version": "latest",
      "tags": [
        "agent"
      ],
      "bin": "claude",
      "verify": {
        "kind": "command",
        "cmd": "claude --version",
        "match": "[0-9]+\\.[0-9]+"
      }
    },
    {
      "id": "codex",
      "type": "harness",
      "backend": "npm-global",
      "description": "OpenAI Codex CLI.",
      "requires": [
        "node"
      ],
      "package": "@openai/codex",
      "version": "latest",
      "tags": [
        "agent"
      ],
      "bin": "codex",
      "verify": {
        "kind": "command",
        "cmd": "codex --version",
        "match": "[0-9]+\\.[0-9]+"
      }
    },
    {
      "id": "opencode",
      "type": "harness",
      "backend": "npm-global",
      "description": "OpenCode terminal coding agent.",
      "requires": [
        "node"
      ],
      "package": "opencode-ai",
      "version": "latest",
      "tags": [
        "agent"
      ],
      "bin": "opencode",
      "verify": {
        "kind": "command",
        "cmd": "opencode --version",
        "match": "[0-9]+\\.[0-9]+"
      }
    },
    {
      "id": "codegraph",
      "type": "tool",
      "backend": "npm-global",
      "description": "Local code knowledge graph exposed to agents over MCP.",
      "requires": [
        "node"
      ],
      "package": "@colbymchenry/codegraph",
      "version": "latest",
      "repository": "colbymchenry/codegraph",
      "tags": [
        "agent-tool",
        "index"
      ],
      "bin": "codegraph",
      "verify": {
        "kind": "command",
        "cmd": "codegraph version",
        "match": "[0-9]+\\.[0-9]+"
      }
    },
    {
      "id": "superpowers",
      "type": "extension",
      "backend": "claude-plugin",
      "description": "Agentic skills framework and TDD-first development methodology.",
      "requires": [
        "claude-code"
      ],
      "repository": "obra/superpowers",
      "marketplace": "obra/superpowers-marketplace",
      "plugin": "superpowers",
      "tags": [
        "agent-ext",
        "skills"
      ],
      "verify": {
        "kind": "plugin"
      },
      "harnesses": {
        "claude-code": {
          "scriptable": true,
          "method": "marketplace"
        },
        "codex": {
          "scriptable": true,
          "method": "marketplace"
        },
        "opencode": {
          "scriptable": true,
          "method": "plugin",
          "arg": "superpowers@git+https://github.com/obra/superpowers.git"
        }
      }
    },
    {
      "id": "caveman",
      "type": "extension",
      "backend": "claude-plugin",
      "description": "Response-compression skill; cuts agent output tokens substantially.",
      "requires": [
        "claude-code"
      ],
      "repository": "JuliusBrussee/caveman",
      "marketplace": "JuliusBrussee/caveman",
      "plugin": "caveman",
      "tags": [
        "agent-ext",
        "skills",
        "tokens"
      ],
      "verify": {
        "kind": "plugin"
      },
      "harnesses": {
        "claude-code": {
          "scriptable": true,
          "method": "marketplace"
        },
        "codex": {
          "scriptable": true,
          "method": "skills-registry"
        },
        "opencode": {
          "scriptable": true,
          "method": "skills-registry"
        }
      }
    },
    {
      "id": "codex-config",
      "type": "extension",
      "backend": "none",
      "description": "Codex model defaults and the fast/arch/power/fix profiles (codex -p <name>).",
      "requires": [
        "codex"
      ],
      "tags": [
        "agent-ext",
        "config"
      ],
      "verify": {
        "kind": "path",
        "path": "$HOME/.codex/config.toml"
      }
    },
    {
      "id": "grill-me",
      "type": "extension",
      "backend": "agent-skill",
      "description": "Relentless interview that stress-tests a plan or design before you build it.",
      "requires": [
        "node"
      ],
      "repository": "mattpocock/skills",
      "skill": "grill-me",
      "tags": [
        "agent-ext",
        "skills",
        "planning"
      ],
      "verify": {
        "kind": "skill"
      },
      "harnesses": {
        "claude-code": {
          "scriptable": true,
          "method": "skills-registry"
        },
        "codex": {
          "scriptable": true,
          "method": "skills-registry"
        },
        "opencode": {
          "scriptable": true,
          "method": "skills-registry"
        }
      }
    },
    {
      "id": "claude-mem",
      "type": "extension",
      "backend": "npx-installer",
      "description": "Persistent memory across sessions — compresses transcripts into a searchable local store.",
      "requires": [
        "node"
      ],
      "repository": "thedotmack/claude-mem",
      "package": "claude-mem",
      "version": "latest",
      "plugin": "claude-mem",
      "tags": [
        "agent-ext",
        "memory"
      ],
      "verify": {
        "kind": "plugin"
      },
      "installer": {
        "install": "install",
        "remove": "uninstall",
        "remove_scope": "global",
        "update": "update",
        "target_flag": "--ide",
        "args": [
          "--provider",
          "${AI_CLAUDE_MEM_PROVIDER}",
          "--no-auto-start"
        ],
        "defaults": {
          "AI_CLAUDE_MEM_PROVIDER": "claude"
        },
        "env": {
          "CLAUDE_MEM_ONLINE_OPTIN": "false"
        }
      },
      "harnesses": {
        "claude-code": {
          "scriptable": true,
          "method": "npx",
          "arg": "claude-code"
        },
        "codex": {
          "scriptable": true,
          "method": "npx",
          "arg": "codex-cli"
        },
        "opencode": {
          "scriptable": true,
          "method": "npx",
          "arg": "opencode"
        }
      }
    },
    {
      "id": "context7",
      "type": "mcp",
      "backend": "mcp-server",
      "description": "Up-to-date, version-specific library documentation over MCP.",
      "requires": [
        "node"
      ],
      "repository": "upstash/context7",
      "server": "context7",
      "tags": [
        "mcp",
        "docs"
      ],
      "verify": {
        "kind": "mcp"
      },
      "mcp": {
        "type": "http",
        "url": "https://mcp.context7.com/mcp",
        "headers": {
          "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
        }
      },
      "harnesses": {
        "claude-code": {
          "scriptable": true,
          "method": "mcp"
        },
        "codex": {
          "scriptable": true,
          "method": "mcp"
        },
        "opencode": {
          "scriptable": true,
          "method": "mcp"
        }
      }
    },
    {
      "id": "django-toolchain",
      "type": "tool",
      "backend": "apt",
      "description": "PostgreSQL and Redis clients for Django service work.",
      "sudo": true,
      "requires": [
        "base",
        "python"
      ],
      "tags": [
        "domain",
        "web"
      ],
      "packages": [
        "postgresql-client",
        "redis-tools",
        "libpq-dev"
      ],
      "bin": "psql",
      "verify": {
        "kind": "command",
        "cmd": "psql --version",
        "match": "psql"
      }
    },
    {
      "id": "gis-toolchain",
      "type": "tool",
      "backend": "apt",
      "description": "GDAL, PROJ, PostGIS client and spatial build headers.",
      "sudo": true,
      "requires": [
        "base",
        "python"
      ],
      "tags": [
        "domain",
        "gis"
      ],
      "packages": [
        "gdal-bin",
        "libgdal-dev",
        "proj-bin",
        "libproj-dev",
        "libgeos-dev",
        "postgresql-client",
        "spatialite-bin"
      ],
      "bin": "ogr2ogr",
      "verify": {
        "kind": "command",
        "cmd": "ogrinfo --version",
        "match": "GDAL"
      }
    }
  ]
}
